{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-server:schema:tool-implementation-bundle-v1",
  "title": "AI Server Tool Implementation Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_format",
    "tool_id",
    "version",
    "runtime_abi",
    "handler_entry_point",
    "input_model_entry_point",
    "output_model_entry_point",
    "dependency_lock_sha256",
    "files"
  ],
  "properties": {
    "artifact_format": {
      "const": "tool-implementation-bundle-v1"
    },
    "tool_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "runtime_abi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "handler_entry_point": {
      "$ref": "#/$defs/entryPoint"
    },
    "input_model_entry_point": {
      "$ref": "#/$defs/entryPoint"
    },
    "output_model_entry_point": {
      "$ref": "#/$defs/entryPoint"
    },
    "dependency_lock_sha256": {
      "$ref": "#/$defs/prefixedHash"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "entryPoint": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_.]*$"
    },
    "prefixedHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/prefixedHash"
        }
      }
    }
  }
}
