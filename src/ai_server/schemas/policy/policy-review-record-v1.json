{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-server:policy:review-record:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version",
    "policy_id",
    "version",
    "content_hash",
    "status",
    "reviewer",
    "reviewed_at",
    "activated_at"
  ],
  "properties": {
    "record_schema_version": {
      "const": "1"
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "content_hash": {
      "$ref": "#/$defs/hash"
    },
    "status": {
      "const": "active"
    },
    "reviewer": {
      "const": "local-owner"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
